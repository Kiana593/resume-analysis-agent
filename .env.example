# ============ LLM API 配置（CLI: enhance / analyze / modify / extract-resume）============
# LLM_PROVIDER: deepseek | iflytek | openai | custom
# 未设置 LLM_PROVIDER 时自动回落旧版 DEEPSEEK_* 变量（向后兼容）
LLM_PROVIDER=deepseek
LLM_API_KEY=
LLM_MODEL=                # 留空用预设默认值（讯飞 4.0Ultra / DeepSeek deepseek-chat）
LLM_BASE_URL=             # 留空用预设默认值（讯飞 https://spark-api-open.xf-yun.com/v1）
LLM_EXTRA_BODY=           # 推理模型参数，如 {"thinking":{"type":"enabled"}}（讯飞 spark-x）
LLM_TIMEOUT=60
LLM_MAX_RETRIES=2

# 旧版 DeepSeek 变量（LLM_PROVIDER 未设置时回落；切到讯飞后可留空）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# 数据源后端：memory（内嵌示例，开箱即用）| neo4j（加载图谱 134 Role）
STORE_BACKEND=memory

# Neo4j 图数据库配置（STORE_BACKEND=neo4j 时必填）
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
