# DeepSeek API 配置（enhance_matches / analyze_gap 需要）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# 数据源后端：memory（内嵌示例，开箱即用）| neo4j（加载图谱 134 Role）
STORE_BACKEND=memory

# Neo4j 图数据库配置（STORE_BACKEND=neo4j 时必填）
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
